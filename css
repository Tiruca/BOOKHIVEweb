*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background-color:#f4f4f4;
}

/* NAVBAR */

nav{
    background:#222;
    color:white;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 40px;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{
    color:white;
    text-decoration:none;
    font-size:18px;
}

nav ul li a:hover{
    color:gold;
}

/* HOME SECTION */

#HOME{
    text-align:center;
    padding:30px;
}

#HOME h2{
    font-size:40px;
    margin-bottom:20px;
}

#HOME img{
    width:100%;
    height:500px;
    object-fit:cover;
    border-radius:10px;
}

/* BUTTON */

button{
    background:#007bff;
    color:white;
    border:none;
    padding:12px 20px;
    margin-top:15px;
    border-radius:6px;
    cursor:pointer;
    font-size:15px;
}

button:hover{
    background:#0056b3;
}

/* FEATURED BOOKS */

h1{
    text-align:center;
    margin:40px 0;
}

/* BOOK CARDS */

div{
    background:white;
    width:300px;
    margin:25px auto;
    padding:20px;
    text-align:center;
    border-radius:12px;
    box-shadow:0px 4px 10px rgba(0,0,0,0.15);
}

div img{
    border-radius:8px;
    margin-bottom:15px;
}

strong{
    display:block;
    font-size:18px;
    margin:10px 0;
}

p{
    color:green;
    font-size:18px;
    margin-bottom:10px;
}

h4,h5{
    margin:10px 0;
    color:#444;
}

hr{
    display:none;
}

/* HOVER EFFECT */

div:hover{
    transform:translateY(-5px);
    transition:0.3s;
}
